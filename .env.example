# Base URL of the Cloudflare Worker backend (no trailing slash).
# Local:  http://localhost:8787
# Prod:   https://<your-worker-name>.<your-subdomain>.workers.dev
VITE_API_BASE_URL=http://localhost:8787

# Google OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Only the client ID belongs here. The client SECRET is never used by this app
# and must never be placed in any VITE_ variable — those ship to the browser.
VITE_GOOGLE_CLIENT_ID=

# Name of your published npm tracker package (shown in the dashboard install steps).
VITE_TRACKER_PACKAGE=

# screenshotmachine.com API key for project thumbnails (free tier available).
VITE_SCREENSHOT_KEY=
